GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
PORT=3001
# Supabase Dashboard -> Connect -> Session pooler. Server only; never use VITE_.
SUPABASE_DB_URL=
# Optional path to the project's CA certificate, downloaded from Database settings.
# SUPABASE_DB_CA_FILE=./certs/prod-supabase.cer
# SSL is required and verified. Only for a loopback PostgreSQL dev instance:
# SUPABASE_DB_SSL=false
# Production HTTPS only:
# SECURE_COOKIES=true
