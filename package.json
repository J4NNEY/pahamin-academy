{
  "name": "pahamin-academy",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web \"node --watch --env-file-if-exists=.env server/index.mjs\" \"vite --host 127.0.0.1\"",
    "build": "tsc -b && vite build",
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "tsc -b",
    "cf:dev": "npm run build && node scripts/cloudflare-dev.mjs",
    "cf:check": "npm run build && wrangler deploy --dry-run --outdir artifacts/cloudflare-bundle",
    "deploy": "npm run build && wrangler deploy",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.mjs",
    "db:check": "node --env-file-if-exists=.env scripts/check-database.mjs",
    "admin:grant": "node --env-file-if-exists=.env scripts/admin-access.mjs",
    "db:import-sqlite": "node --env-file-if-exists=.env scripts/import-sqlite.mjs"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "mammoth": "^1.11.0",
    "multer": "^2.0.2",
    "papaparse": "^5.5.3",
    "pg": "^8.23.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "wrangler": "^4.152.0"
  },
  "engines": {
    "node": ">=24"
  }
}
